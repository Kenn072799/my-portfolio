# Copy to .env and set your existing backend URL.
VITE_API_URL=http://localhost:8080

# Optional contact overrides. Empty values use verified saved content.
VITE_EMAIL=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_FACEBOOK_URL=

# Enter your backend AdminApiKey at /admin/login.
# Admin keys are not configured through VITE_ variables.
